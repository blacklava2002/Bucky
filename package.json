{
  "name": "bucky",
  "description": "A plugin-powered voice assistant for Pebble: talk to set timers and alarms, ask the weather, send texts, or hand off to Claude, Muse, Grok or ChatGPT.",
  "author": "Blacklava2002",
  "license": "MIT",
  "version": "1.5.0",
  "homepage": "https://github.com/blacklava2002/Bucky#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blacklava2002/Bucky.git"
  },
  "bugs": {
    "url": "https://github.com/blacklava2002/Bucky/issues"
  },
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {},
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "pebble": {
    "displayName": "Bucky",
    "uuid": "7f05c316-11a1-4eb6-b3bf-29f630ac7ff7",
    "sdkVersion": "3",
    "projectType": "native",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "configPage": "config.html",
    "messageKeys": [
      "READY",
      "TRANSCRIPT",
      "REQ_ID",
      "RESULT_OK",
      "RESULT_TEXT",
      "RESULT_DETAIL",
      "CLOCK_KIND",
