    "usesPermissions": [
      {
        "name": "Timeline",
        "reason": "To show your timers and alarms in the timeline"
      },
      {
        "name": "SendMessagesBeeper",
        "reason": "To send texts you say through Beeper (Index), after you check them on the watch"
      },
      {
        "name": "ReadWatchSettings",
        "reason": "To see whether Quiet Time is on before turning it on while you talk"
      },
      {
        "name": "WriteWatchSettings",
        "reason": "To turn Quiet Time on while Bucky listens, if you choose that in settings, and put it back after"
      },
      {
        "name": "SetIndexAlarms",
        "reason": "To set alarms and timers on your phone, if you choose that in settings"
      },
      {
        "name": "WriteIndexNotes",
        "reason": "To save notes you say"
      },
      {
        "name": "WriteIndexReminders",
        "reason": "To set reminders and add to your lists"
      },
      {
        "name": "FindMyPhone",
        "reason": "To ring your phone when you say \"find my phone\""
      },
      {
        "name": "Location",
        "reason": "To get the weather where you are when you ask"
      },
      {
        "name": "ControlMusic",
        "reason": "To play, pause and skip songs when you ask"
      },
      {
        "name": "ReadMusic",
        "reason": "To tell you what's playing when you ask"
      },
      {
        "name": "ReadApps",
        "reason": "To find a watch app by name when you say \"launch\" or \"open\""
      },
      {
        "name": "LaunchApps",
        "reason": "To open that app for you"
      }
    ]
  }
